
config gswifi 'main'
	option log_level 'info'

config network 'campus'
	option enabled '0'
	option driver 'ruijie'
	option interface 'wan'
	option username ''
	option password ''

config protect 'protect'
	option mode 'disabled'
	option persona 'pc'
	list wan 'wan'
	list lan 'lan'
	option ttl '1'
	option preserve_traceroute '1'
	option ipid '1'
	option tcp_timestamps '1'
	option dscp_ecn '1'
	option icmp '1'
	option source_ports '1'
	option ipv6 'forward'
	option ntp '0'
	option failure_policy 'bypass'
	option dns_take_over '0'
	option dns_filter_aaaa '0'
	option dns_local_arpa '0'
	option proxy '0'
	option proxy_port '1080'
	option proxy_http_only '1'
	option proxy_ua ''
